# 从企业微信智能机器人 API 配置页面复制。
# 请将本文件复制为 .env 后填写真实值；不要提交 .env。
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 当前阶段仅允许一个企微测试账号进入平台。值来自企微消息日志的 from.userid。
WECOM_TEST_USER_ID=

# AI员工平台后端地址。本地默认值即为 http://127.0.0.1:8000。
PLATFORM_BASE_URL=http://127.0.0.1:8000

# 当前Demo种子数据中的平台员工和目标数字员工。
PLATFORM_ACTOR_NO=E10281
PLATFORM_EMPLOYEE_NO=VE-0003
