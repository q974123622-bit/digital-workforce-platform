# 依赖与构建产物
node_modules/
dist/
coverage/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# 编辑器备份
*.bak
*.bak.*

# 环境变量与密钥（绝不提交）
.env
.env.*
!.env.example
*.pem
*.key

# 数据库与本地状态
*.db
*.db-shm
*.db-wal
*.sqlite3
*.log

# Sandbox 宿主工作区（本机执行隔离挂载目录，不入库）
backend/sandbox-workspaces/
backend/harness-workspaces/
backend/artifacts/
backend/attachments/

# PDF 生成中间文件（最终产物在 output/pdf/）
tmp/

# 外部引用（本机依赖，不入库）
deepseek-harness/
higress/

# 安全 Overlay（仓库外，正式员工专用）
secure-overlay/

# 内部文档（不上传 GitHub）
/数字员工平台原型_PRD与技术路线_v0.1_20260817(1).docx
/数字员工平台Demo_四人开发分工_20260817(1).docx
/数字员工平台Demo_项目计划与完成度交接_20260818.pdf

# 模拟知识库（按真实库结构仿真，内部交付，不随仓库分发）
mock-data/kb/it-service/
mock-data/kb/securities/
mock-data/kb/internal-reg/
mock-data/kb/external-reg/
mock-data/kb/*.zip

# 编辑器
.vscode/
.idea/
.DS_Store

# 离线部署产物与运行时密钥/数据
release/
deploy/offline/secrets/
deploy/offline/data/
deploy/offline/backups/
# 真实部署配置（含模型网关/知识引擎凭据与登录 Key），只提交 config.env.example
deploy/offline/config.env
# Harness 运行时目录（dsh-home 会话、profile 自举产物、node_modules），由 start.sh 生成
deploy/offline/harness/

# dsh 可插拔框架：框架层（runtime）体积大且可由 ops/dsh-install-runtime.sh 重新生成
# 只保留每个版本的 MANIFEST.json（版本/来源/校验值）与 ops/baseline 下的门禁基线
deploy/offline/runtime/*/lib/
deploy/offline/runtime/*/bin/
deploy/offline/runtime/current
deploy/offline/runtime/*/GATE.json

# dsh 运维脚本的运行态产物
deploy/offline/ops/logs/
deploy/offline/ops/state/
deploy/offline/ops/baseline/*.latest.txt
deploy/offline/ops/baseline/*.stderr.txt
deploy/offline/ops/baseline/canary-*.txt
deploy/offline/ops/baseline/gate-*.json

# 离线镜像 tar（体积大，单独传输）
deploy/offline/images/

# 元数据生成过程中的 mktemp 残留（正常路径会被 mv 掉）
deploy/offline/profile/*/MANIFEST.json.*
deploy/offline/runtime/*/MANIFEST.json.*

# 含真实密钥的对接清单（xlsx），禁止提交
docs/*含密钥*
