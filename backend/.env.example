# 数字员工平台 Demo — 环境变量示例（复制为 .env 或直接注入环境变量）
# 注意：真实值只存在于受控环境，绝不提交 Git。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Knowledge provider: mock | rag | internal | volcengine_mcp
DWP_KB_MODE=mock

# Harness Agent loop. Secrets remain in local ignored .env or the company secret system.
DWP_AGENT_EXECUTION_MODE=harness
DWP_PLATFORM_TOOL_BASE_URL=http://host.docker.internal:8000
DWP_HARNESS_TOOL_SIGNING_SECRET=
DWP_STREAM_CHAR_DELAY_MS=16
# Future Volcengine MCP connector. Store only a secret-manager reference here.
DWP_VOLCENGINE_MCP_ENDPOINT=
DWP_VOLCENGINE_MCP_CREDENTIAL_REF=
DWP_VOLCENGINE_MCP_TOOL=knowledge_search

# 嵌入服务（Qwen Embedding，OpenAI 兼容；真实 Key 仅存本地 gitignored .env）
# 默认使用百炼兼容端点；若用 MaaS 工作空间端点，填
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1（{WorkspaceId} 换成真实业务空间 ID）
DWP_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DWP_EMBED_API_KEY=
DWP_EMBED_MODEL=qwen3.7-text-embedding
DWP_EMBED_DIMENSIONS=1024

# 内部知识引擎只读检索（真实值仅放受控 .env）
DWP_INTERNAL_KB_ENDPOINT=
DWP_INTERNAL_KB_CREDENTIAL_REF=
DWP_INTERNAL_KB_BASE_URL=
DWP_INTERNAL_KB_X_ORG=
DWP_INTERNAL_KB_X_TENANT=
DWP_INTERNAL_KB_X_USER=
DWP_INTERNAL_KB_AUTHORIZATION=
DWP_INTERNAL_KB_ID_MAP={}
DWP_ADP_ENDPOINT=
DWP_ADP_CREDENTIAL_REF=
DWP_RPA_ENDPOINT=
DWP_RPA_CREDENTIAL_REF=

# AgentTeams（Matrix 通道，Sprint 8 接入；真实凭据仅存本地受控 .env）
# 注意：团队房间必须成员关系正确（admin/manager/leader/worker 全部 joined），
# 且平台机器人必须加入 Manager 的 groupAllowFrom 白名单；任务消息须 @mention Manager。
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:18080
AGENTTEAMS_ADMIN_USER=
AGENTTEAMS_ADMIN_PASSWORD=
AGENTTEAMS_MATRIX_TOKEN=
AGENTTEAMS_ROOM_ID=
AGENTTEAMS_MANAGER_MXID=@manager:matrix-local.agentteams.io:18080
AGENTTEAMS_COLLAB_TIMEOUT=30
AGENTTEAMS_WORKER_MODEL=deepseek-chat
AGENTTEAMS_WORKER_RUNTIME=copaw
# 以下仅用于显式的管理员全局清理，不用于普通“清空会话”操作
AGENTTEAMS_MANAGER_CONTAINER=agentteams-manager
AGENTTEAMS_MANAGER_DM_ROOM_ID=
AGENTTEAMS_MINIO_ACCESS_KEY=
AGENTTEAMS_MINIO_SECRET_KEY=
