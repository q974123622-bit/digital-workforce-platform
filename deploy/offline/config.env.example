# Copy to config.env. Do not place real credentials in this example file.
# OpenAI-compatible model gateway base URL. The scheme, host and port are all
# replaceable on the bastion. The backend appends /chat/completions.
DEEPSEEK_BASE_URL=http://model-gateway.example.internal:8000/v1
DEEPSEEK_MODEL=replace-with-enabled-model-name
# Normally /chat/completions. Change only when the internal compatible gateway
# exposes the same protocol under another relative path.
DEEPSEEK_CHAT_COMPLETIONS_PATH=/chat/completions

# SSE 逐字符延迟（毫秒）。置 0 = 一次刷出整段答复；非 0 只是观感上的假打字机，
# 会把答复完成时间整体推后（3000 字 × 16ms ≈ 48 秒），不产生任何信息增量。
DWP_STREAM_CHAR_DELAY_MS=0
DWP_MEMORY_MODE=mock
DWP_TENANT_ID=default
DWP_MCP_RUNTIME_MODE=mock
# 会话附件持久化目录。Compose 默认覆盖为 /data/attachments。
DWP_ATTACHMENT_ROOT=/data/attachments

# External MCP services are referenced by logical environment names declared
# in each plugin.yaml. Add non-secret endpoint references here when integrating.
# Put credentials in the target bastion Secret system, never in the ZIP.
# DWP_MCP_EXAMPLE_ENDPOINT=http://mcp-service.example.internal:9000

# 盈米 AI 开放平台 External MCP（基金数据工具，streamable-http + x-api-key）。
# api_key 属敏感凭据：写入 secrets/qieman_api_key，由 Compose 挂载为
# /run/secrets/qieman_api_key（config.py 读取）。不要在此写入真实 Key。
DWP_QIEMAN_MCP_URL=https://stargate.yingmi.com/mcp/v2
# DWP_QIEMAN_MCP_API_KEY=   # 可选：直接写环境变量，优先级高于 secrets 文件
DWP_QIEMAN_MCP_TIMEOUT=20

# 兴业证券 External MCP（智能投顾 chat 工具，streamable-http + SSE，匿名）
DWP_XYZQ_MCP_URL=https://developer.xyzq.cn/agent/a2a/mcp
DWP_XYZQ_MCP_TIMEOUT=20

# 兴证e家员工服务 External MCP（会议室 / 餐卡 / 考勤休假 / 通讯录 / 资讯 / OA 送审等查询类工具）。
# 双鉴权头：
#   * 应用级 X-MCP-API-KEY（静态、必需）：写入 secrets/ehome_mcp_api_key，由 Compose 挂载为
#     /run/secrets/ehome_mcp_api_key（config.py 读取）。不要在此写入真实 Key。
#   * 用户级 X-MCP-JWT（按人签发、会过期）：由员工在会话的「需要补充信息」气泡里粘贴一次，
#     平台加密存到本人名下后复用；平台侧不需要配置，也绝不会把明文写进配置或日志。
DWP_EHOME_MCP_URL=http://10.32.253.43/ehome/mcp/claw
# DWP_EHOME_MCP_API_KEY=   # 可选：直接写环境变量，优先级高于 secrets 文件
DWP_EHOME_MCP_TIMEOUT=20

# 自助接入 MCP 的鉴权密钥加密主密钥（对称加密，Encrypt-then-MAC）。
# 留空时平台拒绝保存任何鉴权密钥，只允许接入「无鉴权」的 MCP 服务。
# 建议放 secrets/mcp_credential_key 并挂载为 /run/secrets/mcp_credential_key，
# 或在此填入一段高熵随机串（不要提交到仓库）。轮换该值会让已保存的密钥
# 无法解密，需要重新登记对应 MCP 服务。
DWP_MCP_CREDENTIAL_KEY=
# When DWP_MEMORY_MODE=internal, supply these through the bastion's Secret mechanism.
DWP_INTERNAL_MEM0_BASE_URL=
DWP_INTERNAL_MEM0_AUTHORIZATION=

# Internal knowledge engine (optional). Never commit or redistribute real values.
DWP_INTERNAL_KB_BASE_URL=
DWP_INTERNAL_KB_RETRIEVAL_PATH=/marketing_agent/api/v2/rag/chunk/retrieval
DWP_INTERNAL_KB_X_ORG=
DWP_INTERNAL_KB_X_TENANT=
DWP_INTERNAL_KB_X_USER=
DWP_INTERNAL_KB_AUTHORIZATION=
# 兼容回退：平台知识库的双后端映射已由 knowledge_base.engine_map 承载（seed 写入），
# 这里只在「知识库行没有 engine_map」的老部署上兜底。
DWP_INTERNAL_KB_ID_MAP={}

# 内部知识引擎 VeRAG MCP（生产环境通道，与上面的测试 REST 通道并存）。
# token 属敏感凭据：写入 secrets/verag_mcp_token，由 Compose 挂载为
# /run/secrets/verag_mcp_token（config.py 读取）。不要在此写入真实 token。
DWP_VERAG_MCP_URL=
DWP_VERAG_MCP_TENANT=6
DWP_VERAG_MCP_TIMEOUT=20
DWP_VERAG_MCP_PROTOCOL_VERSION=2024-11-05
DWP_VERAG_MCP_RETRIEVAL_TOOL=multi_retrieval
DWP_VERAG_MCP_LIST_TOOL=list_knowledge_bases
# DWP_VERAG_MCP_TOKEN=   # 可选：直接写环境变量，优先级高于 secrets 文件

# 知识源可达性治理：auto=生产优先（VeRAG → REST），也可显式指定 test/prod。
DWP_KB_SOURCE_ENV=auto
# 定时探测默认关闭；生产建议置 1，间隔 300 秒。
DWP_KB_SOURCE_PROBE_ENABLED=0
DWP_KB_SOURCE_PROBE_INTERVAL_SECONDS=300
DWP_KB_SOURCE_PROBE_TIMEOUT_SECONDS=15
DWP_KB_SOURCE_TTL_SECONDS=10
DWP_INTERNAL_KB_LIST_PATH=/marketing_agent/api/v2/rag/kb/list
DWP_LOGIN_KEY_E10281=
DWP_LOGIN_KEY_E20999=
DWP_LOGIN_KEY_ADMIN=
DWP_ENABLE_LEGACY_PASSWORD_LOGIN=0

# Harness 单轮执行超时（秒）。岗位AI员工默认 900，数字分身默认 1200（需含委派等待）。
DWP_HARNESS_TIMEOUT_ROLE=900
DWP_HARNESS_TIMEOUT_TWIN=1200
# 被委派方正在执行其他任务时，委派调用等待其空闲的秒数（0 = 立即失败，上限 300）。
DWP_DELEGATION_SLOT_WAIT_SECONDS=120
# 工具令牌有效期与执行过期判定，留空即按单轮上限推导（令牌 = 上限 + 300，过期判定 = 上限 + 600）。
# 这三组数字互相约束，改动任一处必须同时满足：
#   slot_wait + max(role, twin) + 缓冲 <= profile cordis.patch.yml 的 toolCallTimeoutMs / 1000；
#   令牌有效期 >= max(role, twin)；过期判定 > max(role, twin)。
# 校验脚本 ops/dsh-contract-check.js 会按 contract.json 的 timeout_invariant 兜住第一条。
# DWP_HARNESS_TOKEN_TTL_SECONDS=1500
# DWP_EXECUTION_STALE_AFTER_SECONDS=1800

# ---- 用户级 MCP 令牌到期提醒 ----
# 员工侧插件中心会在令牌「即将过期」时常驻提醒（页头汇总 + 服务行内标注 + 到期时间）。
# 这里是提前提醒的天数（默认 7，下限 1）。按人签发的令牌（如兴证e家的 X-MCP-JWT）
# 过期后调用才失败代价太大，因此提前提示；未声明到期时间的凭据不告警。
DWP_MCP_CREDENTIAL_WARN_DAYS=7

# ---- Harness 容器自愈的宿主路径兜底 ----
# AI员工的运行容器被误删时，backend 会经 Docker socket 按编排口径把它建回来
# （镜像 / 4 条挂载 / 标签 / 网络与 compose.yaml 一致），不再要求重新执行部署编排。
# 建容器需要**宿主机**上的 bind 源路径，而 backend 容器里看到的是容器内路径，因此：
#   * 默认自动探测：inspect 自身容器拿到 ./harness 根，inspect 任一兄弟 Harness 容器
#     拿到 runtime / profile 的宿主源、网络与安全选项；
#   * 只有「探测不到」时才需要显式声明下面三项（例如所有 Harness 容器都被删掉的冷启动）。
#     探测失败且未声明会报可读错误并指明缺哪个变量 —— 不会猜路径，
#     因为 Docker 对不存在的 bind 源会静默建空目录，猜错比报错更难查。
# DWP_HARNESS_HOST_ROOT=/opt/dwp-ai-employee-platform/deploy/offline/harness
# DWP_DSH_RUNTIME_HOST=/opt/dwp-ai-employee-platform/deploy/offline/runtime/current
# DWP_PROFILE_HOST=/opt/dwp-ai-employee-platform/deploy/offline/profile/current
# DWP_HARNESS_NETWORK=dwp-ai-employee-platform_dwp

# ---- 内网 SkillHub 技能市场 ----
# 门户地址（不含 API 前缀，免鉴权）。留空即视为「未接入」：管理端「技能市场」页签
# 会明确提示未配置，员工侧不受影响。
DWP_SKILLHUB_BASE_URL=http://10.49.70.2
# 总开关：置 0 可临时关闭 SkillHub 接入（页面与导入接口一律拒绝）。
DWP_SKILLHUB_ENABLED=1
# 单次请求超时（秒，5~120）与目录/分类的进程内缓存 TTL（秒，0 表示不缓存）。
DWP_SKILLHUB_TIMEOUT=30
DWP_SKILLHUB_CACHE_TTL=60

# ---- 材料包上传与上传即转写 ----
# 材料包：一次上传一个 zip（或一批文件），按包内目录 / 文件名前缀自动分业务号，
# 单次不限文件个数（受下面两个配额约束）。
DWP_ATTACHMENT_PACK_MAX_FILES=2000
DWP_ATTACHMENT_PACK_MAX_TOTAL_MB=500
# 上传即转写：图片与 PDF 扫描页在上传阶段转成文本并缓存，执行阶段模型只读文本。
# 关掉它等于回到「执行期读图」，会吃掉单轮时限，ocr_required 状态也会重新出现。
DWP_ATTACHMENT_VISION_ENABLED=1
# 视觉（真读图）只有 ascend-qwen3.6-27b 可用，不要指向别的模型。
DWP_VISION_MODEL=ascend-qwen3.6-27b
# 视觉调用在飞上限与单请求图片数。网关实测 16 路全 200、24 路 502（不是 429），
# 这里默认 12（安全上限 16 留余量）。该值同时是「一次上传多份材料」的解析并发度：
# 附件批量派发复用同一个信号量，只有一处限流点。
DWP_VISION_MAX_INFLIGHT=12
DWP_VISION_BATCH=4
# 视觉单次请求超时（秒，10~300）；失败重试次数（不含首次，0~5）与退避基数（秒）。
# 最坏路径 = (重试 + 1) × 超时 + 退避；默认 1 次重试 ≈ 4 分钟封顶。
DWP_VISION_TIMEOUT_SECONDS=120
DWP_VISION_RETRY=1
DWP_VISION_BACKOFF_SECONDS=1.0
