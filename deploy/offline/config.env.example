# Copy to config.env. Do not place real credentials in this example file.
# OpenAI-compatible model gateway base URL. The scheme, host and port are all
# replaceable on the bastion. The backend appends /chat/completions.
DEEPSEEK_BASE_URL=http://model-gateway.example.internal:8000/v1
DEEPSEEK_MODEL=replace-with-enabled-model-name
# Normally /chat/completions. Change only when the internal compatible gateway
# exposes the same protocol under another relative path.
DEEPSEEK_CHAT_COMPLETIONS_PATH=/chat/completions

# mock is fully offline except for the model request. Change to internal only
# after the internal knowledge settings below have been supplied securely.
DWP_KB_MODE=mock
DWP_STREAM_CHAR_DELAY_MS=16
DWP_MEMORY_MODE=mock
DWP_TENANT_ID=default
DWP_MCP_RUNTIME_MODE=mock

# External MCP services are referenced by logical environment names declared
# in each plugin.yaml. Add non-secret endpoint references here when integrating.
# Put credentials in the target bastion Secret system, never in the ZIP.
# DWP_MCP_EXAMPLE_ENDPOINT=http://mcp-service.example.internal:9000

# When DWP_MEMORY_MODE=internal, supply these through the bastion's Secret mechanism.
DWP_INTERNAL_MEM0_BASE_URL=
DWP_INTERNAL_MEM0_AUTHORIZATION=

# Internal knowledge engine (optional). Never commit or redistribute real values.
DWP_INTERNAL_KB_BASE_URL=
DWP_INTERNAL_KB_RETRIEVAL_PATH=/marketing_agent/api/v2/rag/chunk/retrieval
DWP_INTERNAL_KB_X_ORG=
DWP_INTERNAL_KB_X_TENANT=
DWP_INTERNAL_KB_X_USER=
DWP_INTERNAL_KB_AUTHORIZATION=
DWP_INTERNAL_KB_ID_MAP={}
