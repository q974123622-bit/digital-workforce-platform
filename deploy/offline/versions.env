# dwp AI员工平台 —— dsh 可插拔框架「唯一版本真相」
#
# 本文件是框架层（L1）与 Profile 层（L2）版本切换的唯一入口：
#   - 人工修改本文件后执行 ./ops/dsh-switch.sh --apply  或直接 ./start.sh 重新生成 .env
#   - ops/ 下的脚本通过 set_versions_value() 原子改写本文件
#   - 不要手工编辑 .env 里的 DWP_DSH_RUNTIME*，它由 start.sh / dsh-switch.sh 从本文件展开
#
# 修改后必须执行：./ops/dsh-preflight.sh  （静态契约门禁）
# 灰度切换：      ./ops/dsh-switch.sh AI-GENERAL dsh-0.1.5-rc.1
# 全量切换：      ./ops/dsh-switch.sh --all dsh-0.1.5-rc.1
# 回滚：          ./ops/dsh-rollback.sh

# ---- L0 底座镜像（冻结；提供 node + Python 运行时与灾备兜底 dsh）----
# dwp-dsh:rc6-py = dwp-dsh:rc6 + Python 3.11（含常用三方库），由
# docker/Dockerfile.dsh-runtime 完全离线构建（从本地 dwp-backend 镜像复制运行时）。
# 技能脚本是 `python scripts/...` 形态，缺了 python3 技能就无法真正执行；
# 回退到 dwp-dsh:rc6 即可恢复到「无脚本执行能力」的旧状态。
DWP_DSH_IMAGE=dwp-dsh:rc6-py

# ---- L1 框架层：runtime 目录（相对 deploy/offline/）----
DWP_DSH_RUNTIME=./runtime/dsh-0.1.5-rc.1
DWP_DSH_RUNTIME_VERSION=0.1.5-rc.1

# ---- L2 Profile 层：插件开关 / 模型路由 / 外部工具通道 ----
DWP_PROFILE=./profile/current
DWP_PROFILE_REV=v1-20260910

# ---- 遥测（堡垒机无外网，必须关闭；取值来自 dsh-http-proxy，注意不是 off）----
DWP_DSH_TELEMETRY_MODE=DISABLED

# ---- 开发机侧安装 dsh 时使用的 npm 源（公网 npm 被 SNI 阻断，实测只有该源可用）----
DWP_DSH_NPM_REGISTRY=https://mirrors.huaweicloud.com/repository/npm/

# ---- 按AI员工灰度覆盖（留空 = 沿用全局 DWP_DSH_RUNTIME）----
DWP_DSH_RUNTIME_AI_GENERAL=
DWP_DSH_RUNTIME_AI_INVESTMENT=
DWP_DSH_RUNTIME_AI_RESEARCH=
DWP_DSH_RUNTIME_AI_FUND=
DWP_DSH_RUNTIME_AI_XYZQ=
DWP_DSH_RUNTIME_DT_E10281=
DWP_DSH_RUNTIME_DT_E20999=
